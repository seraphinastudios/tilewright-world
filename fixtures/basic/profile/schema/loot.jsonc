{
  "format": "tilewright.schema/1",
  "fields": {
    // Each roll picks one entry, with probability weight / total weight.
    "entries": {
      "type": "list",
      "required": true,
      "min_items": 1,
      "max_items": 64,
      "items": {
        "type": "object",
        "fields": {
          "item": {"type": "reference", "target": "proto", "required": true},
          "weight": {"type": "integer", "min": 1, "max": 65535, "required": true},
          "count": {
            "type": "object",
            "fields": {
              "min": {"type": "integer", "min": 1, "required": true},
              "max": {"type": "integer", "min": 1, "required": true}
            }
          }
        }
      }
    },
    "chance": {"type": "number", "min": 0, "max": 1}
  }
}
