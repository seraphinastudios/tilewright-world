{
  "format": "tilewright.stairwells/1",
  "stairwells": [
    // Straight: the same tile on three layers.
    {
      "id": "tower.stairs",
      "steps": [
        {"layer": -1, "at": [20, 20], "proto": "stairs_up"},
        {"layer": 0, "at": [20, 20], "proto": "stairs_up"},
        {"layer": 1, "at": [20, 20], "proto": "stairs_down"}
      ]
    },
    // Sloped: one tile across per layer down, drawn on every layer.
    {
      "id": "cliff.path",
      "steps": [
        {"layer": 1, "at": [24, 8], "proto": "stairs_down"},
        {"layer": 0, "at": [25, 8], "proto": "stairs_down"},
        {"layer": -1, "at": [26, 9], "proto": "stairs_up"}
      ],
      "hidden_on_other_layers": false
    },
    // One-way: usable only from the top.
    {
      "id": "cave.chute",
      "steps": [
        {"layer": 0, "at": [28, 28], "proto": "stairs_down"},
        {"layer": -1, "at": [28, 28], "proto": "cave_floor"}
      ],
      "direction": "down",
      "custom": {"example.org/notes": {"reviewed": true}}
    }
  ]
}
